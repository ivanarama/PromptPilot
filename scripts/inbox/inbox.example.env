# Inbox poller — скопируй в scripts/inbox/.env и заполни (.env в git не попадает)
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_USER=tasks@example.mail.ru
IMAP_PASSWORD=пароль-приложения-не-основной
PP_API=http://127.0.0.1:8420
# PP_API_TOKEN=токен-если-включена-авторизация-API
# PP_PROVIDER=claude-z
# PP_PRIORITY=5
# TG_CHAT_ID=1114994337
# CATALOG=projects.json
# PP_TRIAGE_SKIP_PERMISSIONS=1   # разрешить триажу читать сохранённые скриншоты
# ALLOW_FROM=client1@gmail.com,client2.ru   # пусто = принимать от всех
#   автозапуск по секции "auto" в projects.json — только для отправителей,
#   перечисленных здесь или в sender_map (от незнакомца — только карточка)
# MAX_PER_DAY=20
PROJECTS_ROOT=C:\Projects
# --- этап 2 (inbox_bot.py) ---
INBOX_BOT_TOKEN=токен-от-BotFather-для-карточек
# EXEC_PROVIDER=claude-z
# EXEC_MODEL=модель-исполнителя-опционально
# EXEC_SKIP_PERMISSIONS=1
# AUTO_MAX_PER_DAY=3
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_FROM_NAME=PromptPilot
# REPLY_SIGNATURE=С уважением, Иван
# --- игровой конвейер «Сказки Королевства» ([KT] в теме письма) ---
KT_CONCEPT=C:\Projects\mm_rpg_monolithic_gemini\CONCEPT.md
KT_WORKING_DIR=C:\Projects\mm_rpg_monolithic_gemini
KT_PROVIDER=agy
KT_SITE_FEED=C:\Projects\site\kt\feed.json
# Заявки в игру — только с формы сайта (письмо от сервиса формы):
# KT_FORM_ONLY=1
# KT_FORM_DOMAIN=formsubmit.co
# Надёжнее: ещё и подпись DKIM по заголовку Authentication-Results вашего
# почтового сервера. Посмотрите заголовки настоящего письма с формы и впишите
# сервер (первое слово в Authentication-Results), например:
# KT_DKIM_AUTHSERV=mxs.mail.ru
# Свои лимиты игры (не съедают лимит клиентских обращений MAX_PER_DAY):
# KT_MAX_PER_DAY=20
# KT_MAX_PER_AUTHOR=3
# Триаж читает чужой текст — давайте ему провайдера БЕЗ инструментов. Например,
# в ~/.promptpilot/providers.json:
#   "claude-notools": {"cmd": "claude -p --verbose --output-format stream-json --tools \"\" {prompt}",
#                      "description": "Claude без инструментов (триаж)"}
# Провайдер с --dangerously-skip-permissions в команде работает с полными
# правами, в какой бы папке его ни запустили.
# KT_TRIAGE_PROVIDER=claude-notools
# KT_TRIAGE_DIR=C:\PromptPilot\kt-triage     # пустая папка; по умолчанию ~/.promptpilot/kt-triage
# KT_EXEC_PROVIDER=claude                     # исполнитель заявки после «▶ Запустить»
# KT_WALL_SHOW_REJECTED=0                     # показывать ли отклонённые на стене
IMAP_FOLDERS=INBOX,INBOX/ToMyself
