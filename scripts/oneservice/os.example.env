# Oneservice intake — скопируй в scripts/oneservice/.env
GITLAB_URL=https://gitlab.icecorp.ru
GITLAB_TOKEN=glpat-...
GITLAB_PROJECT=1c%2Foneservice-cc_v2
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_USER=tasks@example.mail.ru
IMAP_PASSWORD=пароль-приложения
IMAP_FOLDERS=INBOX
TG_BOT_TOKEN=токен-бота-команды
OS_TG_PASSWORD=пароль-команды
# Белый список почты (адреса/домены через запятую). Письмо не из списка тоже
# станет issue, но с меткой «непроверенный отправитель» — хранитель (LLM) его
# не возьмёт, пока человек не снимет метку. Кто уже писал — .os_senders.json.
# OS_ALLOW_FROM=tester@company.ru,company.ru
# --- этапы 3-4 (os_exec.py) ---
OS_PROVIDER=agy
OS_REVIEW_PROVIDER=claude-z
GITLAB_BOT_USER_ID=96
# OS_GATE_COMMAND=путь\к\синтакс-контролю.cmd
# OS_PLATFORM_REPO=ivanarama/onebase
# Ветка, от которой растут task/<iid> и в которую они вливаются
# (по умолчанию — ветка по умолчанию на origin):
# OS_BASE_BRANCH=master
# Раундов «исполнитель → ревью», после которых нужен человек:
# OS_MAX_ROUNDS=2
