#!/usr/bin/env bash
# PromptPilot provider wrapper: run a CLI on a remote machine over SSH.
#
# Provider cmd template:
#   "claude-vm2": {
#     "cmd": "/path/to/scripts/pp-ssh-run vm2 /home/user/.local/bin/claude -p --verbose --output-format stream-json {prompt}",
#     "description": "Claude Code на vm2",
#     "supports_skills": true
#   }
#
# Everything between <host> and the prompt is the remote command; PromptPilot's
# injected flags (--model / --resume / --dangerously-skip-permissions) arrive
# before the prompt and are forwarded as part of it. stdout/stderr/exit code
# pass through unchanged, so stream-json parsing (cost/session) and the
# worker's rate-limit detection keep working.
#
# Requirements: key-based ssh to <host> (BatchMode — no password prompts);
# use absolute paths for the remote CLI (non-interactive ssh has a bare PATH).
# The remote command runs in the remote $HOME (task working_dir is local-only).

set -u
[ $# -ge 3 ] || { echo "usage: pp-ssh-run <host> <remote-cmd...> <prompt>" >&2; exit 2; }

HOST=$1; shift
PROMPT=${!#}
CMD=("${@:1:$#-1}")

# POSIX single-quote (shlex.quote equivalent): works under any remote login
# shell. printf '%q' emits bash-only $'...' that dash/fish mangle, and it turns
# a multi-line prompt into a broken command.
posix_quote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

REMOTE=
for tok in "${CMD[@]}" "$PROMPT"; do
  REMOTE+="$(posix_quote "$tok") "
done

# '--' before the host so a host that begins with '-' can't be read as an ssh
# option. Keepalives so a silent NAT/firewall drop during a long "thinking"
# turn is detected instead of hanging the task forever.
exec ssh -o BatchMode=yes -o ConnectTimeout=10 \
         -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
         -- "$HOST" "$REMOTE"
