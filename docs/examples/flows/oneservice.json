{
  "name": "oneservice",
  "title": "Oneservice — задачи команды из GitLab",
  "description": "Замена os_intake.py keeper + os_exec.py claim/watch/merge: issue с меткой «подано» → хранитель целесообразности → исполнитель в своей папке (git worktree) → ревью (до 2 кругов) → решение о слиянии → gate → merge → CHANGELOG-TEAM → закрытие issue. Метки GitLab ставятся как раньше — дашборд и команда видят то же. Пути в vars — заменить на свои.",
  "trust": "team",
  "vars": {
    "repo": "C:/Projects/oneservice-cc_v2",
    "worktrees": "C:/Projects/oneservice-worktrees",
    "base": "main",
    "bot_user_id": "",
    "gate": "echo OS gate не задан",
    "python": "python"
  },
  "gitlab": {"url_env": "GITLAB_URL", "token_env": "GITLAB_TOKEN", "project": "group%2Foneservice-cc_v2"},
  "input": {"type": "gitlab_issues", "labels": ["подано"], "exclude_labels": ["непроверенный отправитель"]},
  "exclusive": {"first": "to_base", "last": "changelog_push", "max": 1},
  "limits": {"per_day": 30},
  "steps": [
    {"id": "keeper_start", "kind": "gitlab", "labels": "целесообразность"},
    {
      "id": "keeper",
      "kind": "agent",
      "title": "Хранитель целесообразности",
      "provider": "claude",
      "rights": "read",
      "working_dir": "{{flow.repo}}",
      "prompt_file": "os-keeper.md",
      "material": {"structure": {"tree": "{{flow.repo}}", "depth": 2, "max": 6000}},
      "output": {
        "verdict": {"enum": ["ЦЕЛЕСООБРАЗНО", "НЕ ЦЕЛЕСООБРАЗНО", "ПЛАТФОРМА"]},
        "reason": {"type": "text", "max": 600},
        "spec": {"type": "text", "max": 6000}
      },
      "retries": 1
    },
    {
      "id": "keeper_note",
      "kind": "gitlab",
      "comment": "🧊 **Хранитель целесообразности**\n\nВЕРДИКТ: {{steps.keeper.verdict}}\nПРИЧИНА: {{steps.keeper.reason}}\n\nТЕХНИЧЕСКОЕ ЗАДАНИЕ:\n{{steps.keeper.spec}}"
    },
    {"id": "declined", "kind": "gitlab", "labels": "отклонено",
     "when": {"step": "keeper", "field": "verdict", "in": ["НЕ ЦЕЛЕСООБРАЗНО"]}},
    {"id": "declined_end", "kind": "finish", "status": "rejected",
     "when": {"step": "keeper", "field": "verdict", "in": ["НЕ ЦЕЛЕСООБРАЗНО"]}},
    {"id": "platform", "kind": "gitlab", "labels": "блокирована платформой",
     "comment": "⚓ Эскалация: требуется issue в бэклоге платформы (onebase).",
     "when": {"step": "keeper", "field": "verdict", "in": ["ПЛАТФОРМА"]}},
    {"id": "platform_end", "kind": "finish", "status": "done", "note": "эскалация на платформу",
     "when": {"step": "keeper", "field": "verdict", "in": ["ПЛАТФОРМА"]}},
    {"id": "accepted", "kind": "gitlab", "labels": "триаж-ТЗ"},

    {"id": "fetch", "kind": "command", "run": ["git", "-C", "{{flow.repo}}", "fetch", "origin"],
     "on_error": "continue"},
    {"id": "worktree_new", "kind": "command", "on_error": "continue",
     "run": ["git", "-C", "{{flow.repo}}", "worktree", "add", "-b", "task/{{input.iid}}",
             "{{flow.worktrees}}/task-{{input.iid}}", "origin/{{flow.base}}"]},
    {"id": "worktree_again", "kind": "command",
     "when": {"step": "worktree_new", "field": "ok", "in": [false]},
     "run": ["git", "-C", "{{flow.repo}}", "worktree", "add", "{{flow.worktrees}}/task-{{input.iid}}",
             "task/{{input.iid}}"]},
    {"id": "in_work", "kind": "gitlab", "labels": "в работе,триаж-ТЗ", "assignee_id": "{{flow.bot_user_id}}"},
    {
      "id": "execute",
      "kind": "agent",
      "title": "Исполнитель",
      "provider": "claude",
      "rights": "write",
      "working_dir": "{{flow.worktrees}}/task-{{input.iid}}",
      "prompt_file": "os-execute.md",
      "output": {
        "result": {"enum": ["ГОТОВО", "ПЛАТФОРМА", "НЕ СМОГ"]},
        "summary": {"type": "text", "max": 3000}
      },
      "timeout": 14400
    },
    {"id": "exec_platform", "kind": "gitlab", "labels": "блокирована платформой",
     "comment": "⚓ Платформенная эскалация от исполнителя:\n\n{{steps.execute.summary}}",
     "when": {"step": "execute", "field": "result", "in": ["ПЛАТФОРМА"]}},
    {"id": "exec_platform_end", "kind": "finish", "status": "done", "note": "эскалация на платформу",
     "when": {"step": "execute", "field": "result", "in": ["ПЛАТФОРМА"]}},
    {"id": "exec_failed", "kind": "gitlab", "labels": "нужен человек,в работе",
     "comment": "⚠ Автоматическое исполнение не удалось. Нужен человек.\n\n{{steps.execute.summary}}",
     "when": {"step": "execute", "field": "result", "in": ["НЕ СМОГ"]}},
    {"id": "exec_failed_end", "kind": "finish", "status": "failed",
     "when": {"step": "execute", "field": "result", "in": ["НЕ СМОГ"]}},
    {"id": "stage", "kind": "command", "run": ["git", "-C", "{{flow.worktrees}}/task-{{input.iid}}", "add", "-A"]},
    {"id": "commit", "kind": "command", "ok_codes": [0, 1],
     "run": ["git", "-C", "{{flow.worktrees}}/task-{{input.iid}}", "commit", "-m", "task #{{input.iid}}"]},
    {"id": "diff", "kind": "command", "output_limit": 60000,
     "run": ["git", "-C", "{{flow.worktrees}}/task-{{input.iid}}", "diff", "origin/{{flow.base}}...HEAD"]},
    {"id": "review_start", "kind": "gitlab", "labels": "в работе,ревью"},
    {
      "id": "review",
      "kind": "agent",
      "title": "Ревью",
      "provider": "claude",
      "rights": "read",
      "working_dir": "{{flow.worktrees}}/task-{{input.iid}}",
      "prompt_file": "os-review.md",
      "output": {
        "decision": {"enum": ["PASS", "FAIL"]},
        "remarks": {"type": "text", "max": 3000}
      }
    },
    {
      "id": "review_note",
      "kind": "gitlab",
      "comment": "🔍 **Ревью**\n\nРЕШЕНИЕ: {{steps.review.decision}}\n\n{{steps.review.remarks}}",
      "repeat": {"from": "execute", "when": {"step": "review", "field": "decision", "in": ["FAIL"]},
                 "max": 1, "on_exhausted": "continue"}
    },
    {"id": "review_failed", "kind": "gitlab", "labels": "в работе,нужен человек",
     "when": {"step": "review", "field": "decision", "in": ["FAIL"]}},
    {"id": "review_failed_end", "kind": "finish", "status": "failed", "note": "ревью не пропустило за 2 круга",
     "when": {"step": "review", "field": "decision", "in": ["FAIL"]}},
    {"id": "ready", "kind": "gitlab", "labels": "в работе,готово-к-мержу"},
    {
      "id": "merge_ok",
      "kind": "human",
      "title": "Вливать ли",
      "text": "Влить task/{{input.iid}} («{{item.title}}») в {{flow.base}}?",
      "show": ["steps.review.remarks", "steps.diff.output"]
    },
    {"id": "gate", "kind": "command", "timeout": 3600,
     "cwd": "{{flow.worktrees}}/task-{{input.iid}}", "run": ["cmd", "/c", "{{flow.gate}}"]},
    {"id": "to_base", "kind": "command", "run": ["git", "-C", "{{flow.repo}}", "checkout", "{{flow.base}}"]},
    {"id": "pull", "kind": "command", "run": ["git", "-C", "{{flow.repo}}", "pull", "--ff-only", "origin", "{{flow.base}}"]},
    {"id": "merge", "kind": "command",
     "run": ["git", "-C", "{{flow.repo}}", "merge", "--no-ff", "task/{{input.iid}}", "-m", "Merge task #{{input.iid}}"]},
    {"id": "merge_push", "kind": "command", "run": ["git", "-C", "{{flow.repo}}", "push", "origin", "{{flow.base}}"]},
    {
      "id": "changelog",
      "kind": "command",
      "run": ["{{flow.python}}", "-c",
              "import datetime, pathlib, sys\npath = pathlib.Path(sys.argv[1])\ntitle, _, author = sys.stdin.read().partition('\\n')\npath.parent.mkdir(parents=True, exist_ok=True)\nwith path.open('a', encoding='utf-8') as out:\n    out.write(f\"\\n## {datetime.date.today().isoformat()} — {title.strip()} (issue #{sys.argv[2]})\\n- Предложил: {author.strip() or 'аноним'}\\n- Ветка: task/{sys.argv[2]}\\n\")",
              "{{flow.repo}}/docs/CHANGELOG-TEAM.md", "{{input.iid}}"],
      "stdin": "{{item.title}}\n{{item.author}}"
    },
    {"id": "changelog_add", "kind": "command", "run": ["git", "-C", "{{flow.repo}}", "add", "docs/CHANGELOG-TEAM.md"]},
    {"id": "changelog_commit", "kind": "command",
     "run": ["git", "-C", "{{flow.repo}}", "commit", "-m", "docs: changelog task #{{input.iid}}"]},
    {"id": "changelog_push", "kind": "command", "run": ["git", "-C", "{{flow.repo}}", "push", "origin", "{{flow.base}}"],
     "on_error": "continue"},
    {"id": "cleanup", "kind": "command", "on_error": "continue",
     "run": ["git", "-C", "{{flow.repo}}", "worktree", "remove", "{{flow.worktrees}}/task-{{input.iid}}"]},
    {"id": "closed", "kind": "gitlab", "state": "close",
     "comment": "📦 Задача выполнена и влита в {{flow.base}} (запись в CHANGELOG-TEAM)."},
    {"id": "done", "kind": "finish", "status": "done", "notify": true}
  ]
}
