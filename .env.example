# PromptPilot configuration
# Rename to .env and place next to pp.exe (or in ~/.promptpilot/)
# Values here are only used if the variable is NOT already set in the environment

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Token from @BotFather
PP_TG_TOKEN=your-bot-token-here

# Comma-separated list of allowed phone numbers (international format)
PP_TG_ALLOWED_PHONES=+79001234567,+79007654321

# Proxy for the Telegram API (the bot can't reach api.telegram.org directly in
# some corporate networks). Docker does NOT inherit host env vars, so set it here
# explicitly. Supports http(s):// and socks5:// (socks5://user:pass@host:port).
# Leave empty if Telegram is reachable directly.
# PP_TG_PROXY=http://proxy.corp.local:8080
# PP_TG_PROXY=socks5://proxy.corp.local:1080

# ── Claude CLI ───────────────────────────────────────────────────────────────
# Path to the Claude Code CLI.
# Windows: C:\Users\YourName\.local\bin\claude.exe
# Linux:   /home/username/.local/bin/claude  (or just leave default)
PP_CLAUDE_EXE=C:\Users\YourName\.local\bin\claude.exe

# ── PromptPilot ──────────────────────────────────────────────────────────────
# Default provider: claude, claude-z, codex, qwen, or any custom name
PP_DEFAULT_CLI=claude

# Where to store the database and config files (default: ~/.promptpilot)
# PP_DATA_DIR=C:\PromptPilot\data

# Root folder for project selection in bot/UI (subdirs shown as buttons)
# PP_PROJECTS_ROOT=C:\Projects

# Optional password required to create tasks via Telegram bot (leave empty to disable)
# PP_TASK_PASSWORD=mysecretpassword

# ── LiteLLM proxy (Anthropic-compatible endpoint) ────────────────────────────
# Point Claude Code at a corporate LiteLLM proxy instead of api.anthropic.com.
# Use the /anthropic route; Claude Code appends /v1/messages automatically.
# Example:  http://litellm.corp.local:4000/anthropic
ANTHROPIC_BASE_URL=http://REPLACE-LITELLM-HOST:4000/anthropic

# LiteLLM master key or a virtual key issued from the LiteLLM admin UI.
ANTHROPIC_AUTH_TOKEN=sk-REPLACE-ME

# LiteLLM model IDs surfaced through the Web UI / bot model selector.
# Map the sonnet / opus / haiku tiers (one model for all, or different per tier).
# Used as the fallback when the "Default" option is picked in the model selector.
ANTHROPIC_DEFAULT_SONNET_MODEL=REPLACE-sonnet-model-id
ANTHROPIC_DEFAULT_OPUS_MODEL=REPLACE-opus-model-id
ANTHROPIC_DEFAULT_HAIKU_MODEL=REPLACE-haiku-model-id

# ── Dynamic model discovery ────────────────────────────────────────────────
# When set, PromptPilot queries the provider's /models endpoint (OpenAI format)
# and lists the real available models in the Web UI / bot model selector, instead
# of the hardcoded sonnet/opus/haiku tiers. Picking a model passes it straight to
# Claude Code via --model, so it must be an id the provider actually accepts.
# Leave empty to auto-derive from ANTHROPIC_BASE_URL (strips /anthropic, appends
# /v1/models). Override explicitly if your endpoint differs.
# PP_MODELS_URL=http://litellm.corp.local:4000/v1/models
# Auth token for the request; defaults to ANTHROPIC_AUTH_TOKEN.
# PP_MODELS_TOKEN=sk-REPLACE-ME

# ── Cursor Agent ─────────────────────────────────────────────────────────────
# API key from cursor.com/settings → API Keys
# CURSOR_API_KEY=crsr_your_key_here

# ── Web server ───────────────────────────────────────────────────────────────
PP_HOST=127.0.0.1
PP_PORT=8420

# ── API security ─────────────────────────────────────────────────────────────
# Shared secret for the HTTP API. Required when publishing port 8420 to the
# network. Every /api/* request then needs: Authorization: Bearer <PP_API_TOKEN>
# Generate with: openssl rand -hex 32
PP_API_TOKEN=REPLACE-generate-a-long-random-secret
