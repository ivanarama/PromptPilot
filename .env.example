# PromptPilot configuration
# Rename to .env and place next to pp.exe (or in ~/.promptpilot/)
# Values here are only used if the variable is NOT already set in the environment

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Token from @BotFather
PP_TG_TOKEN=your-bot-token-here

# Comma-separated list of allowed phone numbers (international format)
PP_TG_ALLOWED_PHONES=+79001234567,+79007654321

# Proxy for the Telegram API (some networks block api.telegram.org directly).
# http(s):// or socks5:// (socks5://user:pass@host:port). Docker does NOT inherit
# host env, so set it here. Leave unset if Telegram is reachable directly.
# PP_TG_PROXY=http://proxy.corp.local:8080
# PP_TG_PROXY=socks5://proxy.corp.local:1080

# ── Claude CLI ───────────────────────────────────────────────────────────────
# Full path to the claude binary. Default: found on PATH (claude / claude.exe)
# Linux/macOS:  PP_CLAUDE_EXE=/home/you/.local/bin/claude
# Windows:      PP_CLAUDE_EXE=C:\Users\YourName\.local\bin\claude.exe

# ── Worker: queue, retry, timeout ────────────────────────────────────────────
# Defaults shown. Invalid values fall back to the default with a warning.
# PP_POLL_INTERVAL=5          # seconds between queue polls
# PP_TASK_TIMEOUT=0           # per-task time limit, seconds (0 = no limit)
# PP_BASE_DELAY=60            # first retry delay after a rate limit, seconds
# PP_MAX_DELAY=3600           # cap on the exponential backoff, seconds
# PP_MAX_RETRIES=5            # retries before a rate-limited task is failed

# ── LiteLLM / Anthropic-compatible proxy (опционально) ───────────────────────
# Направить Claude Code на корпоративный LiteLLM-прокси вместо api.anthropic.com.
# ВСЁ ЗАКОММЕНТИРОВАНО НАМЕРЕННО: раскомментируйте и подставьте реальные значения,
# иначе claude пойдёт на несуществующий хост и все задачи упадут.
# PP_DATA_DIR-конфиг и .env читаются автоматически, поэтому активные плейсхолдеры
# сломали бы запуск.
# ANTHROPIC_BASE_URL=http://litellm.corp.local:4000/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-your-litellm-key
# Модели для тиров sonnet/opus/haiku (можно один и тот же id для всех):
# ANTHROPIC_DEFAULT_SONNET_MODEL=your-sonnet-model-id
# ANTHROPIC_DEFAULT_OPUS_MODEL=your-opus-model-id
# ANTHROPIC_DEFAULT_HAIKU_MODEL=your-haiku-model-id
#
# Динамический список моделей в пикере UI/бота (OpenAI-совместимый /models).
# Пусто = вывести из ANTHROPIC_BASE_URL (срезать /anthropic, добавить /v1/models).
# PP_MODELS_URL=http://litellm.corp.local:4000/v1/models
# PP_MODELS_TOKEN=sk-your-litellm-key   # по умолчанию = ANTHROPIC_AUTH_TOKEN

# ── herdr executor ───────────────────────────────────────────────────────────
# For providers with "executor": "herdr" in providers.json — tasks run in live
# herdr sessions (github.com/herdrdev/herdr): visible, blocked tasks wait for
# a human instead of failing. Linux/macOS.
# PP_HERDR_BIN=herdr
# PP_HERDR_READ_LINES=300
# PP_HERDR_START_TIMEOUT_MS=60000
# Keep panes open after successful tasks (per-provider: "keep_pane": true)
# PP_HERDR_KEEP_PANE=0

# herdr → Telegram bridge: the bot notifies authorized users when ANY herdr
# agent is blocked on a dialog or finishes unseen (buttons: approve / screen /
# reply). Set PP_HERDR_WATCH=0 to disable.
# PP_HERDR_WATCH=1
# PP_HERDR_WATCH_INTERVAL=10
# Journal prompts sent straight into herdr panes from the bot (💬 in «🖥 Окна»
# and notifications) into the prompt_log table, keyed by the pane's cwd.
# PP_LOG_PROMPTS=1

# ── PromptPilot ──────────────────────────────────────────────────────────────
# Default provider: claude, claude-z, codex, qwen, or any custom name
PP_DEFAULT_CLI=claude

# Where to store the database and config files (default: ~/.promptpilot)
# Linux/macOS:  PP_DATA_DIR=/home/you/.promptpilot
# Windows:      PP_DATA_DIR=C:\PromptPilot\data

# Root folder for project selection in bot/UI (subdirs shown as buttons)
# Linux/macOS:  PP_PROJECTS_ROOT=/home/you/projects
# Windows:      PP_PROJECTS_ROOT=C:\Projects

# GitHub CLI for the optional external-queue bottleneck analyzer. Usually found
# on PATH; set an explicit path when PromptPilot runs as a background service.
# PP_GH_EXE=C:\Program Files\GitHub CLI\gh.exe
# PP_PIPELINE_PROFILES=C:\PromptPilot\pipeline_profiles.json

# How many tasks the worker runs at once (1 = the sequential worker).
# Two tasks never share a work tree — give them their own worktree to overlap.
# PP_CONCURRENCY=1

# Per-task git worktrees: branch prefix, where checkouts go (empty = next to
# the repository), and which gitignored files to carry into a fresh checkout.
# PP_WORKTREE_PREFIX=pp/
# PP_WORKTREES_ROOT=C:\PromptPilot\worktrees
# PP_WORKTREE_COPY=.env

# Optional password required to create tasks via Telegram bot (leave empty to disable)
# PP_TASK_PASSWORD=mysecretpassword

# ── Cursor Agent ─────────────────────────────────────────────────────────────
# API key from cursor.com/settings → API Keys
# CURSOR_API_KEY=crsr_your_key_here

# ── Web server ───────────────────────────────────────────────────────────────
PP_HOST=127.0.0.1
PP_PORT=8420

# ── Web UI / API auth (optional) ─────────────────────────────────────────────
# When set, the Web UI asks for a login (any username, token as password) and
# the API requires "Authorization: Bearer <token>". Empty = no auth (keep the
# server on 127.0.0.1 in that case).
# PP_API_TOKEN=

# Guard: hard limits for unattended runs (PreToolUse hook).
# auto = on for tasks with --dangerously-skip-permissions, 1 = always, 0 = never.
# Extra rules go in ~/.promptpilot/guard.json.
# PP_GUARD=auto

# Don't start another task when the box is this short on RAM (MB). 0 = no check.
# Concurrency slots say nothing about whether the machine can carry one more run.
# PP_MIN_FREE_MB=0

# Ask each task to end with "ИТОГ: ГОТОВО|УЖЕ СДЕЛАНО|НУЖЕН ЧЕЛОВЕК|НЕ СМОГ".
# Off by default — it appends an instruction to the prompt. Parsed either way.
# PP_VERDICT=0
