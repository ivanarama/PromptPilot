# PromptPilot configuration
# Rename to .env and place next to pp.exe (or in ~/.promptpilot/)
# Values here are only used if the variable is NOT already set in the environment

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Token from @BotFather
PP_TG_TOKEN=your-bot-token-here

# Comma-separated list of allowed phone numbers (international format)
PP_TG_ALLOWED_PHONES=+79001234567,+79007654321

# ── Claude CLI ───────────────────────────────────────────────────────────────
# Full path to the claude binary. Default: found on PATH (claude / claude.exe)
# PP_CLAUDE_EXE=C:\Users\YourName\.local\bin\claude.exe

# ── herdr executor ───────────────────────────────────────────────────────────
# For providers with "executor": "herdr" in providers.json — tasks run in live
# herdr sessions (github.com/herdrdev/herdr): visible, blocked tasks wait for
# a human instead of failing. Linux/macOS.
# PP_HERDR_BIN=herdr
# PP_HERDR_READ_LINES=300
# PP_HERDR_START_TIMEOUT_MS=60000
# Keep panes open after successful tasks (per-provider: "keep_pane": true)
# PP_HERDR_KEEP_PANE=0

# herdr → Telegram bridge: the bot notifies authorized users when ANY herdr
# agent is blocked on a dialog or finishes unseen (buttons: approve / screen /
# reply). Set PP_HERDR_WATCH=0 to disable.
# PP_HERDR_WATCH=1
# PP_HERDR_WATCH_INTERVAL=10

# ── PromptPilot ──────────────────────────────────────────────────────────────
# Default provider: claude, claude-z, codex, qwen, or any custom name
PP_DEFAULT_CLI=claude

# Where to store the database and config files (default: ~/.promptpilot)
# PP_DATA_DIR=C:\PromptPilot\data

# Root folder for project selection in bot/UI (subdirs shown as buttons)
# PP_PROJECTS_ROOT=C:\Projects

# How many tasks the worker runs at once (1 = the sequential worker).
# Two tasks never share a work tree — give them their own worktree to overlap.
# PP_CONCURRENCY=1

# Per-task git worktrees: branch prefix, where checkouts go (empty = next to
# the repository), and which gitignored files to carry into a fresh checkout.
# PP_WORKTREE_PREFIX=pp/
# PP_WORKTREES_ROOT=C:\PromptPilot\worktrees
# PP_WORKTREE_COPY=.env

# Optional password required to create tasks via Telegram bot (leave empty to disable)
# PP_TASK_PASSWORD=mysecretpassword

# ── Cursor Agent ─────────────────────────────────────────────────────────────
# API key from cursor.com/settings → API Keys
# CURSOR_API_KEY=crsr_your_key_here

# ── Web server ───────────────────────────────────────────────────────────────
PP_HOST=127.0.0.1
PP_PORT=8420

# ── Web UI / API auth (optional) ─────────────────────────────────────────────
# When set, the Web UI asks for a login (any username, token as password) and
# the API requires "Authorization: Bearer <token>". Empty = no auth (keep the
# server on 127.0.0.1 in that case).
# PP_API_TOKEN=

# Guard: hard limits for unattended runs (PreToolUse hook).
# auto = on for tasks with --dangerously-skip-permissions, 1 = always, 0 = never.
# Extra rules go in ~/.promptpilot/guard.json.
# PP_GUARD=auto
